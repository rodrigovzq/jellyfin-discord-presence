# Jellyfin. Create the key in Dashboard -> API Keys -> + (any user is fine; it only reads sessions).
JF_URL=http://127.0.0.1:8096
JF_KEY=
JF_USER=

# Discord application id (Discord Developer Portal -> your app -> General Information)
DISCORD_CLIENT_ID=

# Rich Presence asset key uploaded for the app (Rich Presence -> Art Assets)
DISCORD_ASSET=jellyfin

# Seconds between polls
POLL=15
